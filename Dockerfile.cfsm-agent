FROM --platform=$BUILDPLATFORM alpine:3.23 AS fetch

ARG TARGETARCH
ARG AGENT_VERSION=v1.0.11

RUN apk add --no-cache ca-certificates curl

RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) expected="60d971fa54f886da922fd6d7fcb1870e17920d87ec16e2120262005e2a572ba4" ;; \
      arm64) expected="966ab4991f3a96f913f55e1271809d9891c5358b196fb50290631c3d7522fdc5" ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fL --retry 3 \
      "https://github.com/huilang-me/cfsm-agent/releases/download/${AGENT_VERSION}/cf-probe-linux-${TARGETARCH}" \
      -o /cf-probe; \
    echo "${expected}  /cf-probe" | sha256sum -c -; \
    chmod 0555 /cf-probe

FROM scratch

LABEL org.opencontainers.image.source="https://github.com/Zaxlear/CF-Server-Monitor"
LABEL org.opencontainers.image.description="Containerized CF-Server-Monitor Go Probe Agent"
LABEL org.opencontainers.image.version="v1.0.11"

COPY --from=fetch /cf-probe /usr/local/bin/cf-probe
COPY --from=fetch /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

USER 10001:10001

ENTRYPOINT ["/usr/local/bin/cf-probe"]
CMD ["run", "-config=/data/config.conf", "-debug=0"]
